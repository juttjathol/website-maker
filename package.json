{
  "name": "webloom",
  "version": "1.0.0",
  "private": true,
  "description": "Webloom — a no-code drag & drop website builder with one-click export and guided deployment.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "jszip": "^3.10.2",
    "lucide-react": "1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "1.1.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vinext": "1.2.1",
    "vite": "8.3.0"
  },
  "type": "module"
